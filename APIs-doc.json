            "endpoints": [
                {
                    "id": "signup",
                    "title": "Sign Up",
                    "url": "/signup",
                    "method": "POST",
                    "requestBody": {
                        "content": {
                            "application/json": {
                                "example": {
                                    "username": "momen",
                                    "email": "momensaleh2468@gmail.com",
                                    "password": "m1234567"
                                }
                            }
                        }
                    },
                    "responses": [
                        {
                            "status": 201,
                            "description": "Created",
                            "content": {
                                "application/json": {
                                    "example": {
                                        "message": "User Created Successfully"
                                    }
                                }
                            }
                        },
                        {
                            "status": 409,
                            "description": "Conflict",
                            "content": {
                                "application/json": {
                                    "example": {
                                        "statusCode": 409,
                                        "message": "already registerd"
                                    }
                                }
                            }
